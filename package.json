{
  "name": "oklch-table",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "fix": "biome check --write .",
    "check:biome": "biome check .",
    "check:css": "stylelint \"src/**/*.css\"",
    "fix:css": "stylelint \"src/**/*.css\" --fix",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.app.json",
    "check:ts7": "tsc -p tsconfig.domain.json",
    "check:test-types": "tsc6 -p tsconfig.tests.json",
    "check:type-coverage": "type-coverage --project tsconfig.app.json --at-least 100 --strict --ignore-as-assertion --ignore-files \"**/*.test.ts,**/*.type.test.ts\"",
    "check:types": "pnpm check:svelte && pnpm check:ts7 && pnpm check:test-types && pnpm check:type-coverage",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "test:screen-reader": "pnpm build && playwright test --config playwright.screen-reader.config.ts",
    "test:size": "size-limit",
    "check": "pnpm check:biome && pnpm check:css && pnpm check:types && pnpm test:coverage",
    "verify": "pnpm check && pnpm build && pnpm test:size && pnpm test:e2e",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "nanoid": "^6.0.1",
    "nanostores": "^1.0.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.0.0",
    "@biomejs/biome": "^2.0.0",
    "@guidepup/guidepup": "0.31.0",
    "@guidepup/playwright": "0.18.0",
    "@logux/stylelint-config": "1.0.1",
    "@playwright/test": "1.62.1",
    "@size-limit/file": "^12.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/node": "^24.0.0",
    "@typescript/native": "npm:typescript@^7.0.0",
    "@vitest/coverage-v8": "4.1.10",
    "nano-staged": "^1.0.0",
    "simple-git-hooks": "^2.0.0",
    "size-limit": "^12.0.0",
    "stylelint": "17.13.0",
    "svelte-check": "^4.0.0",
    "type-coverage": "2.30.1",
    "typescript": "npm:@typescript/typescript6@^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
